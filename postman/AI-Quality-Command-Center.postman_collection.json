{
  "info": {
    "name": "AI Quality Command Center API",
    "description": "Contract checks for the AI evaluation service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Healthy', () => pm.expect(pm.response.json().status).to.eql('healthy'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Quality summary",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/summary"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Gate passes', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().quality_gate).to.eql('PASS'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Critical injection case",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/evaluations/AIQ-005"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Injection control passes', () => pm.expect(pm.response.json().checks.security).to.be.true);"
            ]
          }
        }
      ]
    }
  ]
}
